# Required. No default: a service that silently falls back to a local database
# looks healthy in production while writing nowhere useful.
DATABASE_URL=postgresql+psycopg://braid:braid@localhost:5432/braid

# Must name the frontend's origin exactly. The frontend sends credentials, and
# browsers reject a wildcard origin on credentialed requests.
WEB_ORIGIN=http://localhost:3000

# "production" makes the session cookie Secure, which localhost cannot use.
ENVIRONMENT=development
